# Security headers
# unsafe-eval is required: TF.js (BlurFace) and Tesseract.js (PdfOcr,
# BulkImageToTextOcr, BulkInvoiceReceiptParser) use eval/new Function()
# internally. Removing it silently breaks those tools. audited 2026-08-31.
# NOTE (2026-09): nonce-based CSP is structurally impossible here — static
# export has no per-request server. Policy stays static; cdnjs is
# deliberately absent from script-src (FFmpeg core loads via fetch+blob,
# which needs only connect-src/worker-src — verified in useFFmpeg.ts).
# blob: IS required in script-src: @ffmpeg/ffmpeg's worker boot calls
# importScripts(blob:coreURL), which is governed by script-src (verified Sep 12
# 2026 — without it every FFmpeg tool fails with "All CDN sources failed").
# challenges.cloudflare.com serves the Turnstile captcha script + iframe
# (email sign-in is dead without it — token never resolves). Pollinations
# serves AI-generated images (img + connect) — blocked img-src broke the
# AI Image Generator entirely (verified Sep 12 2026, live console).
# img-src includes ui-avatars.com (LinkInBioBuilder default avatars).
# If video tools ever fail WASM load in console, check worker-src for data:.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob: https://unpkg.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ui-avatars.com https://image.pollinations.ai; connect-src 'self' blob: data: https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://image.pollinations.ai; worker-src 'self' blob: https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; media-src 'self' blob:; font-src 'self' data:; frame-src 'self' https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed build assets - long cache (filenames change every deploy)
# NOTE: bare "*.ext" globs are NOT valid Pages syntax and match EVERYTHING,
# which once served 1-year immutable on HTML pages (fixed 2026-09-11).
# Only directory-scoped rules below. HTML/pages get no rule = revalidated.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/wasm/*
  Cache-Control: public, max-age=31536000, immutable

# OG images - medium cache (regenerated per deploy)
# (next.config headers() is ignored under output:export, so this is the rule that applies)
/og/*
  Cache-Control: public, max-age=2592000
