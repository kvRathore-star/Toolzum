{
  "name": "99-ai-tools",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:og": "npx tsx scripts/generate-og-images.ts",
    "gen:download-slugs": "npx tsx scripts/generate-download-slugs.ts",
    "gen:redirects": "node scripts/generate-redirects.js",
    "gen:site-data": "npx tsx scripts/generate-site-data.ts",
    "build": "npm run gen:parallel && next build && node scripts/gen-sw.js",
    "gen:parallel": "npm run gen:redirects & npm run gen:og & npm run gen:site-data & npm run gen:download-slugs & wait",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "node scripts/check-load-target.js && npx artillery run --output load-report.json load/artillery.yml && node scripts/check-load-report.js load-report.json",
    "ci": "ANALYZE=true npm run lint && npm run typecheck && vitest run && next build",
    "wasm:optimize": "bash scripts/optimize-wasm.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:deploy": "npm run build && npx wrangler pages deploy out/ --project-name=toolzum",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}' '*.{ts,mjs,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css,md}' '*.{ts,mjs,json}'",
    "analyze": "ANALYZE=true next build",
    "prepare": "husky || true"
  },
