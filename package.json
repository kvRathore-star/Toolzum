  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/generate-sitemap.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "wasm:optimize": "bash scripts/optimize-wasm.sh",
    "cf:deploy": "npm run build && npx wrangler pages deploy out/ --project-name=tool-hub",
