# Toolzum Environment Variables
# Copy this to .env.local and fill in your values

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-random-secret-here-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Public (required — validated at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Server env vars (required — set in Cloudflare Pages secrets or .env.local for dev)
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=

# Required for the AI audio transcription endpoint (functions/api/ai/transcribe.ts)
# Set in Cloudflare Pages secrets. If unset, /api/ai/transcribe returns 500.
GEMINI_API_KEY=

# Cloudflare (for local dev with Wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Turnstile CAPTCHA (contact form)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
