# Toolzum Environment Variables
# Copy this to .env.local and fill in your values

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-random-secret-here-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare (for local dev with Wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Payments — only needed if building the Pro payment flow
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# DODO_API_KEY=
# DODO_API_SECRET=

# Optional: Turnstile CAPTCHA (contact form)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: Sentry error tracking
# SENTRY_DSN=

# Optional: Resend transactional email
# RESEND_API_KEY=

# Analytics (PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
